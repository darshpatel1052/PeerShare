{
  "name": "peerscreen",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/tracker"
  ],
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web-build": "npm run build --workspace=@peerscreen/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixture": "node scripts/generate-fixture.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:browser": "playwright test",
    "contracts:generate": "node packages/contracts/generate.mjs",
    "contracts:check": "node packages/contracts/generate.mjs --check",
    "deps": "node scripts/dependencies.mjs up",
    "stop": "node scripts/dependencies.mjs stop",
    "api:build": "node scripts/go.mjs build",
    "api:test": "node scripts/go.mjs test",
    "api:vet": "node scripts/go.mjs vet",
    "migrate": "node scripts/go.mjs migrate",
    "seed": "node scripts/go.mjs seed-fixture",
    "test:integration": "node scripts/integration.mjs",
    "test:recovery": "node scripts/recovery.mjs",
    "compose:demo": "node scripts/compose-demo.mjs",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
