  "sql": "WITH matching_channels AS MATERIALIZED (SELECT id FROM catalog.channels WHERE strpos(lower(title),lower($2::text))>0), candidates AS ((SELECT v.id,v.published_at FROM catalog.videos v WHERE v.publication_state='published' AND v.deleted_at IS NULL AND v.source_kind<>'fixture' AND v.search_document @@ websearch_to_tsquery('pg_catalog.simple',$2::text) ORDER BY v.published_at DESC,v.id DESC LIMIT $1) UNION (SELECT per.id,per.published_at FROM matching_channels mc CROSS JOIN LATERAL (SELECT v.id,v.published_at FROM catalog.videos v WHERE v.channel_id=mc.id AND v.publication_state='published' AND v.deleted_at IS NULL AND v.source_kind<>'fixture' ORDER BY v.published_at DESC,v.id DESC LIMIT $1) per ORDER BY per.published_at DESC,per.id DESC LIMIT $1)) SELECT v.id,v.channel_id,c.title,c.handle,v.title,v.description,v.tags,v.source_kind,v.duration_seconds,v.accepted_generation_id,v.accepted_attempt_id,v.qualities,v.published_at,v.manifest_key,v.integrity_key,v.thumbnail_key,COALESCE(v.thumbnail_image_id::text,'') FROM candidates hit JOIN catalog.videos v ON v.id=hit.id JOIN catalog.channels c ON c.id=v.channel_id ORDER BY v.published_at DESC,v.id DESC LIMIT $1",
