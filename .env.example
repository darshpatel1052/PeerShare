# Reference only: the local scripts prepare configuration automatically.
# Real passwords live in ignored .local/local.env (mode 0600).
# Do not copy credentials into frontend build variables or commit private files.

# Runtime API configuration. Local setup supplies DATABASE_URL and REDIS_URL.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
API_LISTEN_ADDR=127.0.0.1:18080
MEDIA_BASE_URL=http://localhost:3000/media/
TRACKER_URL=ws://localhost:8000

# Optional native-demo override to exercise playback across origins:
# MEDIA_BASE_URL=http://localhost:3001/
# The frontend receives these URLs from the API at runtime.

# Production browser URLs require HTTPS/WSS and registration stays disabled.
# These settings alone do not constitute a production deployment.
# APP_ENV=production
# REGISTRATION_ENABLED=false
# UPLOADS_ENABLED=true
# Production uploads also require a live PostgreSQL creator approval.
# Grant through the server: /peerscreen creator-access grant USER_ID 24
# Optional, separate Redis cache. An empty value disables it; never reuse the
# noeviction rate-limiter instance for this allkeys-lru workload.
# ANALYTICS_REDIS_URL=redis://:server-only-password@redis-cache:6379/0

# Optional free Google sign-in. Set these in ignored .local/google.env, not this reference.
# Obtain a Web application OAuth client from Google Auth Platform.
# Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-server-only-client-secret
