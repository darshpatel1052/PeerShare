# Reference only: the local scripts prepare configuration automatically.
# Real passwords live in ignored .local/local.env (mode 0600).
# Do not copy credentials into frontend build variables or commit private files.

# Runtime API configuration. Local setup supplies DATABASE_URL and REDIS_URL.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
API_LISTEN_ADDR=127.0.0.1:18080
MEDIA_BASE_URL=http://localhost:3000/media/
TRACKER_URL=ws://localhost:8000

# Optional native-demo override to exercise playback across origins:
# MEDIA_BASE_URL=http://localhost:3001/
# The frontend receives these URLs from the API at runtime.

# Production browser URLs require HTTPS/WSS and registration stays disabled.
# These settings alone do not constitute a production deployment.
# APP_ENV=production
# REGISTRATION_ENABLED=false
