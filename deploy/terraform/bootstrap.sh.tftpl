#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
cat >/etc/systemd/system/peerscreen-demo-stop.service <<'UNIT'
[Unit]
Description=Stop PeerScreen demo host at the bounded deployment deadline
[Service]
Type=oneshot
ExecStart=/sbin/shutdown -h now
UNIT
cat >/etc/systemd/system/peerscreen-demo-stop.timer <<'UNIT'
[Unit]
Description=Bounded PeerScreen demonstration runtime
[Timer]
OnCalendar=REPLACE_DEADLINE
Persistent=true
Unit=peerscreen-demo-stop.service
[Install]
WantedBy=timers.target
UNIT
deadline=$(date -u --date='+${demo_hours} hours' '+%Y-%m-%d %H:%M:%S UTC')
sed -i "s/REPLACE_DEADLINE/$deadline/" /etc/systemd/system/peerscreen-demo-stop.timer
systemctl daemon-reload
systemctl enable --now peerscreen-demo-stop.timer
apt-get update
apt-get install -y docker.io docker-compose-v2 ffmpeg git ca-certificates certbot unzip gnupg curl python3
systemctl stop docker
disk=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${volume_id}
for count in $(seq 1 120); do
  if [ -b "$disk" ]; then break; fi
  sleep 1
done
test -b "$disk"
if ! blkid "$disk" >/dev/null 2>&1; then mkfs.ext4 "$disk"; fi
mkdir -p /srv/peerscreen/data
disk_uuid=$(blkid -s UUID -o value "$disk")
if ! grep -q "$disk_uuid" /etc/fstab; then
  echo "UUID=$disk_uuid /srv/peerscreen/data ext4 defaults,nofail 0 2" >> /etc/fstab
fi
mount /srv/peerscreen/data
mkdir -p /etc/docker /srv/peerscreen/data/docker
cat >/etc/docker/daemon.json <<'JSON'
{"data-root":"/srv/peerscreen/data/docker","log-driver":"json-file","log-opts":{"max-size":"10m","max-file":"3"}}
JSON
systemctl enable --now docker
echo 'PeerScreen host prepared with a bounded runtime. Deploy the verified release and origin certificate next.'
