{
  "admin": {
    "address": {
      "socket_address": {
        "address": "0.0.0.0",
        "port_value": 9901
      }
    },
    "access_log": []
  },
  "static_resources": {
    "listeners": [
      {
        "name": "local-http",
        "address": {
          "socket_address": {
            "address": "0.0.0.0",
            "port_value": 8080
          }
        },
        "per_connection_buffer_limit_bytes": 32768,
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.http_connection_manager",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                  "stat_prefix": "peerscreen",
                  "codec_type": "AUTO",
                  "use_remote_address": true,
                  "normalize_path": true,
                  "merge_slashes": true,
                  "path_with_escaped_slashes_action": "REJECT_REQUEST",
                  "request_headers_timeout": "5s",
                  "stream_idle_timeout": "120s",
                  "max_request_headers_kb": 16,
                  "upgrade_configs": [
                    {
                      "upgrade_type": "websocket",
                      "enabled": false
                    }
                  ],
                  "route_config": {
                    "name": "application",
                    "request_headers_to_remove": [
                      "forwarded",
                      "x-forwarded-for",
                      "x-forwarded-host",
                      "x-forwarded-proto",
                      "x-user-id"
                    ],
                    "request_headers_to_add": [
                      {
                        "header": {
                          "key": "x-peerscreen-client-ip",
                          "value": "%DOWNSTREAM_REMOTE_ADDRESS_WITHOUT_PORT%"
                        },
                        "append_action": "OVERWRITE_IF_EXISTS_OR_ADD"
                      }
                    ],
                    "response_headers_to_add": [
                      {
                        "header": {
                          "key": "x-content-type-options",
                          "value": "nosniff"
                        },
                        "append_action": "OVERWRITE_IF_EXISTS_OR_ADD"
                      },
                      {
                        "header": {
                          "key": "referrer-policy",
                          "value": "strict-origin-when-cross-origin"
                        },
                        "append_action": "OVERWRITE_IF_EXISTS_OR_ADD"
                      },
                      {
                        "header": {
                          "key": "x-frame-options",
                          "value": "DENY"
                        },
                        "append_action": "OVERWRITE_IF_EXISTS_OR_ADD"
                      }
                    ],
                    "virtual_hosts": [
                      {
                        "name": "peerscreen",
                        "domains": ["localhost:3400"],
                        "routes": [
                          {
                            "match": {
                              "path": "/metrics"
                            },
                            "direct_response": {
                              "status": 404
                            }
                          },
                          {
                            "match": {
                              "prefix": "/media/fixture/"
                            },
                            "direct_response": {
                              "status": 404
                            }
                          },
                          {
                            "match": {
                              "path": "/tracker"
                            },
                            "route": {
                              "cluster": "tracker",
                              "timeout": "0s",
                              "prefix_rewrite": "/",
                              "idle_timeout": "60s",
                              "upgrade_configs": [
                                {
                                  "upgrade_type": "websocket",
                                  "enabled": true
                                }
                              ]
                            }
                          },
                          {
                            "match": {
                              "prefix": "/media/videos/"
                            },
                            "route": {
                              "cluster": "catalogue",
                              "timeout": "120s",
                              "prefix_rewrite": "/api/v1/media/videos/"
                            }
                          },
                          {
                            "match": {
                              "prefix": "/api/v1/"
                            },
                            "route": {
                              "cluster": "catalogue",
                              "timeout": "120s"
                            }
                          },
                          {
                            "match": {
                              "prefix": "/health/"
                            },
                            "route": {
                              "cluster": "catalogue",
                              "timeout": "120s"
                            }
                          },
                          {
                            "match": {
                              "prefix": "/"
                            },
                            "route": {
                              "cluster": "web",
                              "timeout": "120s"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "http_filters": [
                    {
                      "name": "envoy.filters.http.router",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "clusters": [
      {
        "name": "catalogue",
        "cluster_type": {
          "name": "envoy.clusters.dns",
          "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster",
            "dns_refresh_rate": "2s",
            "dns_lookup_family": "V4_ONLY",
            "all_addresses_in_single_endpoint": false
          }
        },
        "connect_timeout": "2s",
        "lb_policy": "ROUND_ROBIN",
        "load_assignment": {
          "cluster_name": "catalogue",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "api",
                        "port_value": 8080
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "circuit_breakers": {
          "thresholds": [
            {
              "priority": "DEFAULT",
              "max_connections": 64,
              "max_pending_requests": 64,
              "max_requests": 128,
              "max_retries": 0
            }
          ]
        },
        "health_checks": [
          {
            "timeout": "1s",
            "interval": "2s",
            "no_traffic_interval": "2s",
            "no_traffic_healthy_interval": "2s",
            "unhealthy_threshold": 2,
            "healthy_threshold": 1,
            "http_health_check": {
              "path": "/health/ready"
            }
          }
        ]
      },
      {
        "name": "web",
        "cluster_type": {
          "name": "envoy.clusters.dns",
          "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster",
            "dns_refresh_rate": "2s",
            "dns_lookup_family": "V4_ONLY",
            "all_addresses_in_single_endpoint": false
          }
        },
        "connect_timeout": "2s",
        "lb_policy": "ROUND_ROBIN",
        "load_assignment": {
          "cluster_name": "web",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "web",
                        "port_value": 3000
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "circuit_breakers": {
          "thresholds": [
            {
              "priority": "DEFAULT",
              "max_connections": 64,
              "max_pending_requests": 64,
              "max_requests": 128,
              "max_retries": 0
            }
          ]
        },
        "health_checks": [
          {
            "timeout": "1s",
            "interval": "2s",
            "no_traffic_interval": "2s",
            "no_traffic_healthy_interval": "2s",
            "unhealthy_threshold": 2,
            "healthy_threshold": 1,
            "http_health_check": {
              "path": "/health/live"
            }
          }
        ]
      },
      {
        "name": "tracker",
        "cluster_type": {
          "name": "envoy.clusters.dns",
          "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster",
            "dns_refresh_rate": "2s",
            "dns_lookup_family": "V4_ONLY",
            "all_addresses_in_single_endpoint": false
          }
        },
        "connect_timeout": "2s",
        "lb_policy": "ROUND_ROBIN",
        "load_assignment": {
          "cluster_name": "tracker",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "web",
                        "port_value": 8000
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "circuit_breakers": {
          "thresholds": [
            {
              "priority": "DEFAULT",
              "max_connections": 64,
              "max_pending_requests": 64,
              "max_requests": 128,
              "max_retries": 0
            }
          ]
        },
        "health_checks": [
          {
            "timeout": "1s",
            "interval": "2s",
            "no_traffic_interval": "2s",
            "no_traffic_healthy_interval": "2s",
            "unhealthy_threshold": 2,
            "healthy_threshold": 1,
            "http_health_check": {
              "path": "/health/live"
            }
          }
        ]
      }
    ]
  }
}
